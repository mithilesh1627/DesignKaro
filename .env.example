# ==============================================================================
# DesignKaro Environment Variables
# "Socho. Design Karo. Scale Karo."
# ==============================================================================

# Application
PROJECT_NAME="DesignKaro"
VERSION="0.1.0"
ENVIRONMENT="development" # development | staging | production
DEBUG=true

# Security
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 Days

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="designkaro"
# Use asyncpg for asynchronous database operations
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/designkaro"

# Redis Configuration (Cache, Pub/Sub, Simulation state)
REDIS_URL="redis://localhost:6379/0"

# AI Provider Configuration (Phase 8+)
# Pluggable: openai | anthropic | gemini | local
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-pro"
AI_API_KEY=""

# Vector Database (Phase 14+ RAG)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
